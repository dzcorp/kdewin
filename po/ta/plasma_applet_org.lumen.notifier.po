#: plasma/notifier/FullRepresentation.qml:81
msgid "Do not disturb"
msgstr "தொந்தரவு செய்யாதே"

#: plasma/notifier/FullRepresentation.qml:131
msgid "For 1 hour"
msgstr "1 மணிநேரத்துக்கு"

#: plasma/notifier/FullRepresentation.qml:136
msgid "For 4 hours"
msgstr "4 மணிநேரத்துக்கு"

#: plasma/notifier/FullRepresentation.qml:145
msgid "Until this evening"
msgstr "இன்று மாலை வரை"

#: plasma/notifier/FullRepresentation.qml:155
msgid "Until tomorrow morning"
msgstr "நாளை காலை வரை"

#: plasma/notifier/FullRepresentation.qml:167
msgid "Until Monday"
msgstr "திங்கள் வரை"

#: plasma/notifier/FullRepresentation.qml:174
msgid "Until manually disabled"
msgstr "கைமுறையாக முடக்கும் வரை"

#: plasma/notifier/FullRepresentation.qml:226
msgctxt "Do not disturb until date"
msgid "Automatically ends: %1"
msgstr "தானாக முடிவது: %1"

#: plasma/notifier/FullRepresentation.qml:238
msgctxt "Do not disturb until app has finished (reason)"
msgid "While %1 is active (%2)"
msgstr "%1 செயலில் இருக்கும்போது (%2)"

#: plasma/notifier/FullRepresentation.qml:240
msgctxt "Do not disturb until app has finished"
msgid "While %1 is active"
msgstr "%1 செயலில் இருக்கும்போது"

#: plasma/notifier/FullRepresentation.qml:246
msgctxt "Do not disturb because external mirrored screens connected"
msgid "Screens are mirrored"
msgstr "திரைகள் பிரதிபலிக்கப்படுவதால்"

#: plasma/notifier/FullRepresentation.qml:250
msgctxt "Do not disturb because fullscreen app is focused"
msgid "Fullscreen app is focused"
msgstr "தற்போதைய செயலி முழுத்திரை பயன்முறையிலுள்ளது"

#: plasma/notifier/FullRepresentation.qml:510
#: plasma/notifier/FullRepresentation.qml:516
msgctxt "@action:button"
msgid "View"
msgstr "காட்டு"

#: plasma/notifier/FullRepresentation.qml:597
msgid "Close Group"
msgstr "குழுவை மூடு"

#: plasma/notifier/FullRepresentation.qml:619
msgid "Show Fewer"
msgstr "சிலவற்றையே காட்டு"

#: plasma/notifier/FullRepresentation.qml:621
msgctxt "Expand to show n more notifications"
msgid "Show %1 More"
msgstr "இன்னும் %1 காட்டு"

#: plasma/notifier/FullRepresentation.qml:650 plasma/notifier/main.qml:108
msgid "No unread notifications"
msgstr "படிக்காத அறிவிப்புகள் இல்லை"

#: plasma/notifier/FullRepresentation.qml:665 plasma/notifier/main.qml:77
msgid "Notification service not available"
msgstr "அறிவிப்பு சேவை கிடைக்கவில்லை"

#: plasma/notifier/FullRepresentation.qml:667
msgctxt "Vendor and product name"
msgid "Notifications are currently provided by '%1 %2'"
msgstr "அறிவிப்புகள் தற்போது '%1 %2' என்பதால் வழங்கப்படுகின்றன"

#: plasma/notifier/components/ActionContainer.qml:92
msgctxt "Reply to message"
msgid "Reply"
msgstr "பதிலளி"

#: plasma/notifier/fileinfo.cpp:186
msgid "Open with %1"
msgstr "%1-ஆல் திற"

#: plasma/notifier/fileinfo.cpp:190
msgid "Open with…"
msgstr "இதனால் திற…"

#: plasma/notifier/filemenu.cpp:117
msgid "Open Containing Folder"
msgstr "கொண்டுள்ள அடைவைத் திற"

#: plasma/notifier/filemenu.cpp:131
msgid "&Copy"
msgstr "&நகலெடு"

#: plasma/notifier/filemenu.cpp:140
msgctxt "@action:incontextmenu"
msgid "Copy Location"
msgstr "இருப்பிடத்தை நகலெடு"

#: plasma/notifier/filemenu.cpp:198
msgid "Properties"
msgstr "பண்புகள்"

#: plasma/notifier/globalshortcuts.cpp:24
msgid "Toggle do not disturb"
msgstr "தொந்தரவு செய்யாமையை நிலைமாற்று"

#: plasma/notifier/globalshortcuts.cpp:33
msgctxt "@action"
msgid "Clear Notification History"
msgstr "அறிவிப்பு வரலாற்றைக் காலியாக்கு"

#: plasma/notifier/globalshortcuts.cpp:52
msgctxt "OSD popup, keep short"
msgid "Notifications Off"
msgstr "அறிவிப்புகள் முடக்கப்பட்டன"

#: plasma/notifier/globalshortcuts.cpp:53
msgctxt "OSD popup, keep short"
msgid "Notifications On"
msgstr "அறிவிப்புகள் இயக்கப்பட்டன"

#: plasma/notifier/globalshortcuts.cpp:68
msgctxt "@label OSD popup, keep short"
msgid "Notification history cleared"
msgstr "அறிவிப்பு வரலாறு காலியாக்கப்பட்டுள்ளது"

#: plasma/notifier/main.qml:61
msgid "%1 running job"
msgid_plural "%1 running jobs"
msgstr[0] "%1 நடைபெறும் பணி"
msgstr[1] "%1 நடைபெறும் பணிகள்"

#: plasma/notifier/main.qml:65
msgctxt "Job title (percentage)"
msgid "%1 (%2%)"
msgstr "%1 (%2%)"

#: plasma/notifier/main.qml:70
msgid "%1 running job (%2%)"
msgid_plural "%1 running jobs (%2%)"
msgstr[0] "%1 நடைபெறும் பணி (%2%)"
msgstr[1] "%1 நடைபெறும் பணிகள் (%2%)"

#: plasma/notifier/main.qml:83
msgid "%1 unread notification"
msgid_plural "%1 unread notifications"
msgstr[0] "%1 படிக்காத அறிவிப்பு"
msgstr[1] "%1 படிக்காத அறிவிப்புகள்"

#: plasma/notifier/main.qml:88
msgid "%1 active notification"
msgid_plural "%1 active notifications"
msgstr[0] "%1 அறிவிப்பு செயலிலுள்ளது"
msgstr[1] "%1 அறிவிப்புகள் செயலிலுள்ளன"

#: plasma/notifier/main.qml:101
msgid "Do not disturb until %1; middle-click to exit now"
msgstr "%1 வரை தொந்தரவு செய்யாது; இப்போதே முடக்க நடு-கிளிக் செய்யவும்"

#: plasma/notifier/main.qml:104
msgid "Do not disturb mode active; middle-click to exit"
msgstr "தொந்தரவு செய்யா பயன்முறை செயலில் உள்ளது; முடக்க நடு-கிளிக் செய்யவும்"

#: plasma/notifier/main.qml:110
msgid "Middle-click to enter do not disturb mode"
msgstr "தொந்தரவு செய்யா பயன்முறையில் நுழைய நடு-கிளிக் செய்யவும்"

#: plasma/notifier/main.qml:245
msgid "Clear All Notifications"
msgstr "அனைத்து அறிவிப்புகளையும் நீக்கு"

#: plasma/notifier/main.qml:264
msgid "&Configure Event Notifications and Actions…"
msgstr "நிகழ்வுகளுக்கான அறிவிப்புகள் மற்றும் செயல்களை &அமை…"
